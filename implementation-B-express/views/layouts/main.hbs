<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="South Indian Hospital appointment management" />
  <meta name="theme-color" content="#147a50" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23147a50'/%3E%3Cpath d='M16 7v18M7 16h18' stroke='white' stroke-width='4' stroke-linecap='round'/%3E%3C/svg%3E" />
  <title>{{#if title}}{{title}} · {{/if}}South Indian Hospital</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="topbar"><div class="topbar-inner">
    <span><b>24×7 Emergency:</b> +91-1800-123-456</span>
    <span>OPD Mon–Sat · 9:00 AM – 6:00 PM · Nerul, Navi Mumbai</span>
  </div></div>

  <div class="brandbar"><div class="brandbar-inner">
    <div class="logo" aria-hidden="true">+</div>
    <div class="brand-text">
      <h1>South Indian Hospital</h1>
      <p>Appointment Management System</p>
    </div>
  </div></div>

  <nav class="navbar" aria-label="Primary">
    <div class="navbar-inner">
      <a href="/" class="{{#if (eq activeNav "home")}}active{{/if}}">Home</a>
      <a href="/doctors" class="{{#if (eq activeNav "doctors")}}active{{/if}}">Doctors</a>
      <a href="/appointments" class="{{#if (eq activeNav "appointments")}}active{{/if}}">Appointments</a>
    </div>
  </nav>

  <main class="container">
    {{#if breadcrumb}}
      <p class="breadcrumb">{{{breadcrumb}}}</p>
    {{/if}}
    {{{body}}}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <h4>South Indian Hospital</h4>
        <p>Multi-speciality care across cardiology, orthopedics, pediatrics and dermatology.</p>
      </div>
      <div>
        <h4>Quick links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/doctors">Doctors</a></li>
          <li><a href="/appointments">Appointments</a></li>
          <li><a href="/patient/1">Sample patient record</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li>Reception: +919922221111</li>
          <li>appointments@sihospital.com</li>
          <li>SIES Nerul, Navi Mumbai</li>
        </ul>
      </div>
    </div>
    <div class="bottombar">Made with ❤️ by Varun Trimukhe</div>
  </footer>
</body>
</html>
