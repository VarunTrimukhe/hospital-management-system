<div class="card error-hero">
  <div class="error-code">ERROR {{errorCode}}</div>
  <h2 style="margin:6px 0">{{title}}</h2>
  <p class="muted">{{message}}</p>
  <p class="muted" style="font-size:13px">Available routes: <code>/</code> · <code>/doctors</code> · <code>/doctor/:id</code> · <code>/appointments</code> · <code>/patient/:id</code></p>
  <p style="margin-top:16px"><a class="btn" href="{{backLink}}">{{backText}}</a></p>
</div>
